{
  "name": "fetch-fun",
  "version": "0.5.0",
  "description": "Functional fetch toolkit: pipeable config functions over a plain options object, typed data flow, Standard Schema validation, smart retry and per-attempt timeout. Zero dependencies.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "commit": "lint-staged && git-cz -n",
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json && node scripts/gen-dmts.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "coverage": "vitest run --coverage --coverage.reporter=lcov",
    "lint": "eslint --fix src test",
    "lint:pkg": "publint --strict",
    "attw": "attw --pack .",
    "size": "size-limit",
    "verify:tree-shaking": "node scripts/verify-tree-shaking.mjs",
    "test": "vitest",
    "start": "vitest watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmzy/fetch-fun.git"
  },
  "keywords": [
    "fetch",
    "http",
    "http-client",
    "functional",
    "pipe",
    "middleware",
    "typed",
    "standard-schema",
    "retry",
    "timeout"
  ],
  "author": "wmzy",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wmzy/fetch-fun/issues"
  },
  "homepage": "https://github.com/wmzy/fetch-fun#readme",
  "files": [
    "dist",
    "src"
  ],
  "size-limit": [
    {
      "name": "full bundle (dist/index.mjs, min+gz)",
      "path": "dist/index.mjs",
      "disablePlugins": [
        "@size-limit/esbuild"
      ],
      "gzip": true,
      "limit": "8 KB"
    },
    {
      "name": "minimal usage: create/url/fetchJSON/json (min+gz)",
      "path": "src/index.ts",
      "import": "{ create, url, fetchJSON, json }",
      "gzip": true,
      "limit": "4 KB"
    }
  ],
  "lint-staged": {
    "*.js": [
      "cross-env NODE_ENV=production eslint --fix",
      "git add"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/esbuild": "^13.0.3",
    "@size-limit/file": "^13.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "publint": "^0.3.24",
    "size-limit": "^13.0.3",
    "tools-config": "^0.2.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
